ANTHROPIC_API_KEY=

POSTGRES_USER=llmops
POSTGRES_PASSWORD=llmops
POSTGRES_DB=llmops
DATABASE_URL=postgresql+psycopg://llmops:llmops@postgres:5432/llmops

DEFAULT_MODEL=claude-sonnet-5
JUDGE_MODEL=claude-opus-5

# Local Ollama fallback for the demo RAG app (not used for eval judges or
# regression testing, which need a strong frontier model). Requires Ollama
# (https://ollama.com) running on the host with OLLAMA_MODEL pulled, e.g.
# `ollama pull llama3.2:3b`. Set to true to let /demo/ask keep working with
# zero ANTHROPIC_API_KEY, or as a resilience fallback when Claude errors out.
ENABLE_OLLAMA_FALLBACK=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
